# DISABLED: the pipeline runs locally (docker compose up -d builder). Rename back to patch.yml to re-enable.
name: Build curated APKs

on:
  workflow_dispatch:
    inputs:
      force:
        description: "Build even when patch bundles are unchanged"
        type: boolean
        required: false
        default: false
  schedule:
    - cron: "0 6 * * *"

permissions:
  contents: write

concurrency:
  group: build
  cancel-in-progress: false

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    services:
      trawl:
        image: ghcr.io/germondai/trawl:latest
        ports:
          - 8191:8191
        options: --shm-size=1gb
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Restore patch state
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release download latest --pattern .patch-state.json --dir . 2>/dev/null || true
          if [ -f .patch-state.json ]; then mv .patch-state.json .previous-patch-state.json; fi

      - name: Check patch sources
        id: updates
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: python scripts/check_patch_updates.py --previous .previous-patch-state.json --state .patch-state.json ${{ inputs.force && '--force' || '' }}

      - name: Set build date
        if: steps.updates.outputs.should_build == 'true'
        id: build-date
        run: echo "value=$(date -u +%Y%m%d)" >> "$GITHUB_OUTPUT"

      - name: Download original APKs
        if: steps.updates.outputs.should_build == 'true'
        id: download
        continue-on-error: true
        env:
          GITHUB_TOKEN: ${{ github.token }}
          TRAWL_URL: http://localhost:8191
          SOURCES_TO_BUILD: ${{ steps.updates.outputs.sources_to_build }}
        run: python -m src download

      - name: Patch configured entries
        if: always() && steps.updates.outputs.should_build == 'true'
        id: build
        continue-on-error: true
        env:
          GITHUB_TOKEN: ${{ github.token }}
          BUILD_DATE: ${{ steps.build-date.outputs.value }}
          SOURCES_TO_BUILD: ${{ steps.updates.outputs.sources_to_build }}
        run: python -m src patch

      - name: Finalize successful source state
        if: always() && steps.updates.outputs.should_build == 'true' && hashFiles('build-results.json') != ''
        run: python scripts/finalize_patch_state.py --previous .previous-patch-state.json --candidate .patch-state.json --results build-results.json

      - name: Publish latest build
        if: always() && steps.updates.outputs.should_build == 'true' && hashFiles('dist/*.apk') != ''
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          shopt -s nullglob
          apks=( dist/*.apk )
          if [ "${#apks[@]}" -eq 0 ]; then
            echo "::error::No APKs were built"
            exit 1
          fi
          {
            printf 'Curated build generated on %s UTC.\n\n' "$(date -u +'%Y-%m-%d %H:%M')"
            for apk in "${apks[@]}"; do printf -- '- `%s`\n' "${apk#dist/}"; done
          } > release-notes.md
          if gh release view latest >/dev/null 2>&1; then
            gh release upload latest "${apks[@]}" .patch-state.json --clobber
            gh release edit latest --title "Latest build" --notes-file release-notes.md
          else
            gh release create latest "${apks[@]}" .patch-state.json --title "Latest build" --notes-file release-notes.md --latest
          fi

      - name: Report failed entries
        if: always() && (steps.download.outcome == 'failure' || steps.build.outcome == 'failure')
        run: exit 1
